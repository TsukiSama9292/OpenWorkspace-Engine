{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 5173",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && eslint .",
    "check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "analysis": "eslint . --rule complexity:warn --rule max-lines-per-function:warn",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "analyze": "node scripts/analyze-bundle.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.0",
    "jsdom": "^29.1.1",
    "svelte": "^5.56.7",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@skeletonlabs/skeleton": "^5.0.0",
    "@skeletonlabs/skeleton-svelte": "^5.0.0",
    "pako": "1"
  }
}
