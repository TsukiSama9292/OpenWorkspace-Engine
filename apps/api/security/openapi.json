  "info": {
    "description": "OpenAPI spec for the 17 security-fuzzable endpoints plus the admin-gated Monitor snapshot (see .scratch/security-fuzzing, .scratch/monitor-dashboard). Admin-gated operations are tagged `admin-gated` for the low-privilege RBAC-boundary pass. The spec is export-only and never served.",
    "license": {
      "name": ""
    },
    "title": "OpenWorkspace API — security fuzz surface",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/admin/settings": {
      "get": {
        "operationId": "get_settings",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsEnvelope"
                }
              }
            },
            "description": "global policy settings"
          },
          "401": {
            "description": "missing or invalid ow_token"
          },
          "403": {
            "description": "requires admin"
          },
          "500": {
            "description": "internal server error"
          }
        },
        "tags": [
          "admin-gated"
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContextEnvelope"
                }
              }
            },
            "description": "authenticated; sets the ow_token cookie"
          },
          "400": {
            "description": "request body is not valid JSON (syntax error)"
          },
          "401": {
            "description": "invalid credentials"
          },
          "415": {
            "description": "missing Content-Type: application/json"
          },
          "422": {
            "description": "malformed JSON body"
          },
          "500": {
            "description": "internal server error"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContextEnvelope"
                }
              }
            },
            "description": "current effective context"
          },
          "401": {
            "description": "missing or invalid ow_token"
          },
          "500": {
            "description": "internal server error"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/validate": {
      "get": {
        "operationId": "validate",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateEnvelope"
                }
              }
            },
            "description": "session identity"
          },
          "401": {
            "description": "missing or invalid ow_token"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/docker/containers": {
      "get": {
        "operationId": "list_docker_containers",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DockerContainersEnvelope"
                }
              }
            },
            "description": "docker containers visible to the host"
          },
          "401": {
            "description": "missing or invalid ow_token"
          },
          "403": {
            "description": "requires can_manage_docker or admin"
          },
          "500": {
            "description": "internal server error"
          }
        },
        "tags": [
          "admin-gated"
        ]
      }
    },
    "/api/groups": {
      "get": {
        "operationId": "list_groups",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupListEnvelope"
                }
              }
            },
            "description": "group catalog with template whitelists"
          },
          "401": {
            "description": "missing or invalid ow_token"
          },
          "403": {
            "description": "requires can_manage_users or admin"
          },
          "500": {
            "description": "internal server error"
          }
        },
        "tags": [
          "admin-gated"
        ]
      }
    },
    "/api/instances": {
      "get": {
        "operationId": "list_instances",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstanceListEnvelope"
                }
              }
            },
            "description": "instances visible to the caller"
          },
          "401": {
            "description": "missing or invalid ow_token"
          },
          "500": {
            "description": "internal server error"
          }
        },
        "tags": [
          "instances"
        ]
      }
    },
    "/api/instances/{id}": {
      "get": {
        "operationId": "get_instance",
        "parameters": [
          {
            "description": "instance uuid",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstanceEnvelope"
                }
              }
            },
            "description": "instance detail (includes access credentials)"
          },
          "400": {
            "description": "invalid uuid"
          },
          "401": {
            "description": "missing or invalid ow_token"
          },
          "403": {
            "description": "not allowed to view this instance"
          },
          "404": {
            "description": "instance not found"
          },
          "500": {
            "description": "internal server error"
          }
        },
        "tags": [
          "instances"
        ]
      }
    },
    "/api/monitor/snapshot": {
      "get": {
        "operationId": "snapshot",
        "parameters": [
          {
            "description": "Resolution: `1h` (15 s series) or `24h` (5 min aggregates); defaults to `1h`.",
            "in": "query",
            "name": "range",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonitorSnapshotEnvelope"
                }
              }
            },
            "description": "host and per-instance resource series"
          },
          "400": {
            "description": "invalid range value"
          },
