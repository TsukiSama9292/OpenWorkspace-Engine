            "type": [
              "integer",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "template_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "can_create_template",
          "can_manage_users",
          "can_manage_group_instances",
          "can_manage_docker",
          "can_manage_registry",
          "can_view_monitoring",
          "template_ids"
        ],
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
