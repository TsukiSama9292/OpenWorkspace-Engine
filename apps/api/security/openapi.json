{
  "components": {
    "schemas": {
      "ContextEnvelope": {
        "properties": {
          "context": {
            "$ref": "#/components/schemas/EffectiveContext"
          }
        },
        "required": [
          "context"
        ],
        "type": "object"
      },
      "DockerContainerSchema": {
        "properties": {
          "id": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "names": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "state": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "names",
          "image",
          "status",
          "state"
        ],
        "type": "object"
      },
      "DockerContainersEnvelope": {
        "properties": {
          "containers": {
            "items": {
              "$ref": "#/components/schemas/DockerContainerSchema"
            },
            "type": "array"
          }
        },
        "required": [
          "containers"
        ],
        "type": "object"
      },
      "EffectiveContext": {
        "description": "The resolved permissions and ceilings for a user at a point in time. This\nstruct is serialized as the `/auth/me` envelope, so its field names are\npart of the public API contract.",
        "properties": {
          "allowed_template_ids": {
            "description": "Union of every member group's whitelist (group-only authorization). No\npersonal whitelist and no creator self-whitelist (spec Decision 4/5).\nHidden templates are always excluded — they never appear in the\nwhitelist, so clients can treat this list as \"everything I may launch\".",
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "type": "array"
          },
          "can_create_template": {
            "type": "boolean"
          },
          "can_manage_docker": {
            "type": "boolean"
          },
          "can_manage_group_instances": {
            "type": "boolean"
          },
          "can_manage_registry": {
            "type": "boolean"
          },
          "can_manage_users": {
            "type": "boolean"
          },
          "can_view_monitoring": {
            "description": "Monitor-dashboard gate: seeing the Monitor tab / snapshot endpoint\n(admin or a group flag; Manager system group defaults on).",
            "type": "boolean"
          },
          "direct_max_instances": {
            "description": "The personal override, if any. The effective ceiling is the max of this\nand the group maxima, so a personal ceiling can only raise, never lower,\nwhat the groups grant.",
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "effective_max_instances": {
            "description": "`0` means \"no ceiling\" (matches the `host_instance_limit = 0`\nconvention). Non-zero values are exact per-user limits. Resolved as the\n*maximum* of the personal ceiling and every group ceiling, where 0/NULL\n= unlimited is the highest (spec Decision 4).",
            "format": "int32",
            "type": "integer"
          },
          "group_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "type": "array"
          },
          "is_admin": {
            "description": "Root: derived from Admin-group membership, never stored (spec Decision\n4). Replaces the dropped `is_system_admin` column.",
            "type": "boolean"
          },
          "tier": {
            "description": "The maximum tier across the user's group memberships (0/1/2).",
            "format": "int32",
            "type": "integer"
          },
          "user_id": {
            "format": "uuid",
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "username",
          "is_admin",
          "tier",
          "can_create_template",
          "can_manage_users",
          "can_manage_group_instances",
          "can_manage_docker",
          "can_manage_registry",
          "can_view_monitoring",
          "effective_max_instances",
          "allowed_template_ids",
          "group_ids"
        ],
        "type": "object"
      },
      "GroupListEnvelope": {
        "properties": {
          "groups": {
            "items": {
              "$ref": "#/components/schemas/GroupSchema"
            },
            "type": "array"
          }
