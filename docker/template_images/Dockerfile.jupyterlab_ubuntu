ARG VERSION=jammy

FROM ubuntu:${VERSION}

EXPOSE 8888

RUN apt-get update && apt-get upgrade -y && apt-get install -y \
    sudo \
    curl \
    git \
    wget \
    openssl \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash ow_user

# Nix installation (Package manager)
RUN mkdir -p /nix && chown ow_user:ow_user /nix
RUN su - ow_user -c "curl -L https://nixos.org/nix/install | sh -s -- --no-daemon"
RUN su - ow_user -c "mkdir -p ~/.config/nix && echo 'experimental-features = nix-command flakes' >> ~/.config/nix/nix.conf"
ENV PATH="/home/ow_user/.nix-profile/bin:${PATH}"

# Set directory permissions for ow_user
RUN chown -R ow_user:ow_user /etc/ssl/private /etc/ssl/certs

COPY ./entrypoint/entrypoint_jupyterlab.sh /home/ow_user/entrypoint.sh
RUN chmod +x /home/ow_user/entrypoint.sh

USER ow_user
WORKDIR /home/ow_user

# 將 uv 安裝與專案初始化合併在同一個 RUN 區塊，確保環境變數與指令連貫
RUN export UV_INSTALL_DIR="/home/ow_user/.local/bin" && \
    export PATH="$UV_INSTALL_DIR:$PATH" && \
    curl -LsSf https://astral.sh/uv/install.sh | sh && \
    uv tool install jupyterlab && \
    PROJECT_DIR="/home/ow_user/workspace/example-project" && \
    mkdir -p "$PROJECT_DIR" && \
    cd "$PROJECT_DIR" && \
    uv init --no-readme && \
    uv add ipykernel && \
    uv run python -m ipykernel install --user --name=example-project --display-name="Python (Example Project)"

ENV UV_INSTALL_DIR=/home/ow_user/.local/bin

ENTRYPOINT ["/home/ow_user/entrypoint.sh"]